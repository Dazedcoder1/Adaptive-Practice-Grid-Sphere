# ── AdaptiveLearn AI — copy to .env and fill in. Never commit .env. ────────────

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Base URL used in emailed links (verify email, reset password, guardian consent)
FRONTEND_URL=http://localhost:3000
# true ONLY behind our own reverse proxy (infra/nginx), which overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false

# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Pooled endpoint — used by the API and workers
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct endpoint (no "-pooler") — used by Alembic migrations
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Redis (cache + Celery broker) ──────────────────────────────────────────
# docker compose overrides this to redis://redis:6379/0 inside containers
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Students must click an emailed link before first sign-in (off for now)
REQUIRE_EMAIL_VERIFICATION=false

# Apply mastery / revision / error-notebook updates right after each answer, in-process,
# so no Celery worker is needed locally. Set false in production and run the workers.
PROCESS_EVENTS_INLINE=true

# ─── Email ──────────────────────────────────────────────────────────────────
# console = print emails (with their links) in the backend log — fine for local dev
EMAIL_BACKEND=console
EMAIL_FROM=AdaptiveLearn AI <no-reply@adaptivelearn.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ─── Cloudflare R2 ──────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# "Token value" — Cloudflare API token; not needed for uploads/downloads
R2_API_TOKEN=
# Optional public bucket URL (r2.dev or custom domain), no trailing slash
R2_PUBLIC_URL=

# ─── AI tutor & search (optional) ────────────────────────────────────────────
# Leave LLM_PROVIDER empty and the tutor answers from approved study notes (no AI).
# LLM_PROVIDER: openai | gemini | anthropic | openai_compatible
# LLM_MODEL blank = default (openai gpt-4.1-mini · gemini gemini-3.5-flash-lite ·
# anthropic claude-haiku-5-5). Check your provider's model list; change it in Admin → AI.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Optional fallback provider used when the first one fails
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Semantic search (embeddings): openai | gemini | openai_compatible. Blank = keyword search only.
# EMBEDDING_API_KEY blank = reuse LLM_API_KEY when it's the same provider.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
